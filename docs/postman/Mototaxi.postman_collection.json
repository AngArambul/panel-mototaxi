{
  "info": {
    "_postman_id": "c2de321e-6f75-43b3-9cad-24add1af19a5",
    "name": "Mototaxi • API local",
    "description": "Ejecuta con una base sintética. La carpeta webhook requiere un Node de prueba y no se dirige a producción. Los tokens se introducen sólo como valores locales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Perfil por Sanctum",
      "item": [
        {
          "name": "Perfil propio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{perfil_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/user"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Proyección mínima\", () => pm.expect(Object.keys(pm.response.json())).to.have.members([\"id_usuario\",\"nombre\",\"rol\"]));",
                  "pm.test(\"Respuesta no almacenada en caché\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin credencial",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/api/user"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token sin habilidad de perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{perfil_token_otro}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/user"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token revocado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{perfil_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/user"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "description": "Revoca en Laravel el token de perfil antes de ejecutar esta solicitud."
        }
      ]
    },
    {
      "name": "Webhook aislado",
      "item": [
        {
          "name": "Verificar desafío local",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/api/webhook/whatsapp?hub.mode=subscribe&hub.verify_token={{webhook_verify_token}}&hub.challenge=desafio-sintetico"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Desafío literal\", () => pm.expect(pm.response.text()).to.eql(\"desafio-sintetico\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar desafío con token erróneo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/api/webhook/whatsapp?hub.mode=subscribe&hub.verify_token=token-incorrecto&hub.challenge=desafio-sintetico"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar firma inválida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Hub-Signature-256",
                "value": "sha256=firma-invalida"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/api/webhook/whatsapp",
            "body": {
              "mode": "raw",
              "raw": "{\"object\":\"whatsapp_business_account\",\"entry\":[]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
